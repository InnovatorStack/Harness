{
    "name": "@innovatorstack/harness",
    "version": "0.1.1",
    "private": false,
    "description": "Local testing and instrumentation for Aras Innovator, built with Bun and TypeScript",
    "keywords": [
        "aml",
        "aras",
        "aras-innovator",
        "bun",
        "csharp",
        "innovator",
        "instrumentation",
        "integration-testing",
        "mocking",
        "plm",
        "sqlite",
        "test-harness",
        "testing",
        "typescript"
    ],
    "homepage": "https://innovatorstack.github.io/Harness/",
    "bugs": {
        "url": "https://github.com/InnovatorStack/Harness/issues"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/InnovatorStack/Harness.git"
    },
    "files": [
        "dist",
        "src/**/*.ts",
        "src/baseline/data/*.json",
        "README.md",
        "LICENSE",
        "assets/brand",
        "examples",
        "skills"
    ],
    "type": "module",
    "exports": {
        "./engine": {
            "types": "./dist/engine.d.ts",
            "import": "./dist/engine.js"
        },
        "./items": {
            "types": "./dist/items/item.d.ts",
            "import": "./dist/items/item.js"
        },
        "./methods": {
            "types": "./dist/methods/types.d.ts",
            "import": "./dist/methods/types.js"
        },
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./core": {
            "types": "./dist/core/index.d.ts",
            "import": "./dist/core/index.js"
        },
        "./storage/sqlite": {
            "types": "./dist/storage/sqlite/index.d.ts",
            "import": "./dist/storage/sqlite/index.js"
        },
        "./packages": {
            "types": "./dist/packages/index.d.ts",
            "import": "./dist/packages/index.js"
        },
        "./csharp": {
            "types": "./dist/methods/csharp/index.d.ts",
            "import": "./dist/methods/csharp/index.js"
        }
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "build": "bun run scripts/build.ts",
        "release:check": "bun run scripts/release-check.ts",
        "check": "bun run scripts/check.ts",
        "lint": "bun run scripts/style/check.ts",
        "typecheck": "bun --bun run tsc --noEmit",
        "format": "bun run scripts/style/format.ts --write",
        "format:check": "bun run scripts/style/format.ts",
        "test": "bun run scripts/run-tests.ts"
    },
    "dependencies": {
        "es-module-lexer": "3.0.4",
        "sax": "^1.6.1"
    },
    "devDependencies": {
        "@types/bun": "^1.4.4",
        "@types/sax": "^1.2.7",
        "oxfmt": "0.78.0",
        "oxlint": "1.93.0",
        "oxlint-plugin-complexity": "4.1.0",
        "oxlint-tsgolint": "7.0.2006",
        "typescript": "7.0.2",
        "ultracite": "8.1.1"
    },
    "engines": {
        "bun": ">=1.3.13"
    }
}
